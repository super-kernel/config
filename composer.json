{
    "name": "super-kernel/config",
    "type": "library",
    "license": "MIT",
    "description": "The config component for super-kernel.",
    "keywords": [
        "php",
        "swoole",
        "super-kernel",
        "config"
    ],
    "autoload": {
        "psr-4": {
            "SuperKernel\\Config\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SuperKernelTest\\Config\\": "tests/src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "classmap-authoritative": true
    },
    "minimum-stability": "stable",
    "require": {
        "php": "~8.4.0",
        "super-kernel/annotation": "^1.0",
        "super-kernel/attribute": "^1.0",
        "super-kernel/contract": "~1.0.0"
    },
    "require-dev": {
        "super-kernel/di": "~1.0.0"
    }
}
