{
    "name": "super-kernel/config",
    "description": "Typed lazy configuration source registry for SuperKernel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4.27 <8.5",
        "ext-reflection": "*",
        "psr/container": "^2.0.2",
        "super-kernel/annotator": "self.version",
        "super-kernel/attribute": "self.version",
        "super-kernel/contract": "self.version",
        "super-kernel/di": "self.version",
        "super-kernel/reflector": "self.version",
        "super-kernel/support": "self.version"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpunit/phpunit": "^13.4.5",
        "super-kernel/context": "self.version"
    },
    "autoload": {
        "psr-4": {
            "SuperKernel\\Config\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SuperKernel\\Config\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "format": "@php vendor/bin/php-cs-fixer fix --show-progress=bar --no-ansi",
        "format:check": "@php vendor/bin/php-cs-fixer check --show-progress=bar --no-ansi --diff",
        "test": "@php vendor/bin/phpunit"
    }
}
